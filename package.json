{
  "name": "agent-bus",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "A tiny MCP coordination server — a shared board, mailbox, and work-claim bus for a fleet of autonomous coding agents running across separate hosts.",
  "bin": {
    "agent-bus": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/express": "5.0.6",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  }
}
